# OpenAI-compatible Nemotron endpoint
NEMOTRON_API_URL=https://YOUR_OPENAI_COMPATIBLE_ENDPOINT/v1/chat/completions

# Exact model identifier exposed by that endpoint
NEMOTRON_MODEL_NAME=YOUR_NEMOTRON_MODEL_ID

# Bearer token for the endpoint
NEMOTRON_API_KEY=YOUR_API_KEY

# Optional locally. Cloud Run injects PORT automatically.
PORT=8080
